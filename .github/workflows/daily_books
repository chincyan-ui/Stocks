name: Daily Z-Library Books Push

on:
  schedule:
    # UTC 01:00 = 北京时间 (UTC+8) 09:00
    - cron: "0 1 * * *"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  push-books:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: "pip"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then
            pip install -r requirements.txt
          else
            pip install requests
          fi

      - name: Run daily book pusher
        env:
          TG_BOT_TOKEN: ${{ secrets.TG_BOT_TOKEN }}
          TG_CHAT_ID: ${{ secrets.TG_CHAT_ID }}
          ZLIB_URL: ${{ vars.ZLIB_URL || 'https://z-library.sk' }}
          ZLIB_COOKIE: ${{ secrets.ZLIB_COOKIE }}
          BOOK_LIMIT: ${{ vars.BOOK_LIMIT || '10' }}
        run: python push_books.py
