const axios = require('axios');

// 配置信息（通过环境变量读取，更安全）
const TG_TOKEN = process.env.TG_TOKEN;
const TG_CHAT_ID = process.env.TG_CHAT_ID;

// 待监控的股票列表（对应原脚本获取的头部公司）
const SYMBOLS = ["AAPL", "MSFT", "GOOGL", "AMZN", "NVDA", "META", "TSLA", "BRK-B", "TSM", "UNH", "V", "JPM"]; 

async function getStockData(symbol) {
    try {
        // 获取 5 年历史数据计算 ATH
        const res = await axios.get(`https://query1.finance.yahoo.com/v8/finance/chart/${symbol}?interval=1d&range=5y`, {
            headers: { 'User-Agent': 'Mozilla/5.0' }
        });
        
        const result = res.data.chart.result[0];
        const meta = result.meta;
        const highs = result.indicators.quote[0].high.filter(x => x != null);
        
        const currentPrice = meta.regularMarketPrice;
        const ath = Math.max(...highs, currentPrice);
        const drawdown = ((currentPrice - ath) / ath) * 100;

        return {
            symbol: symbol,
            price: currentPrice.toFixed(2),
            ath: ath.toFixed(2),
            drawdown: drawdown.toFixed(2)
        };
    } catch (e) {
        console.error(`Error fetching ${symbol}: ${e.message}`);
        return null;
    }
}

async function main() {
    console.log("开始获取行情...");
    let results = [];
    
    for (const symbol of SYMBOLS) {
        const data = await getStockData(symbol);
        if (data) results.push(data);
        // 稍微等待避免被封
        await new Promise(resolve => setTimeout(resolve, 500));
    }

    // 按回撤幅度排序（值越小说明跌得越多）
    results.sort((a, b) => parseFloat(a.drawdown) - parseFloat(b.drawdown));

    // 取前 10 个
    const top10 = results.slice(0, 10);

    // 构建消息
    let message = `📊 *每日股票回撤榜 (Top 10)*\n\n`;
    top10.forEach((s, index) => {
        message += `${index + 1}. *${s.symbol}*\n`;
        message += `   现价: $${s.price} | ATH: $${s.ath}\n`;
        message += `   *回撤: ${s.drawdown}%*\n\n`;
    });

    // 发送到 Telegram
    if (TG_TOKEN && TG_CHAT_ID) {
        await axios.post(`https://api.telegram.org/bot${TG_TOKEN}/sendMessage`, {
            chat_id: TG_CHAT_ID,
            text: message,
            parse_mode: "Markdown"
        });
        console.log("消息已发送至 Telegram");
    } else {
        console.log("未配置 TG 信息，输出结果：\n", message);
    }
}

main();
